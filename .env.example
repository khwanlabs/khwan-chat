# Khwan Chat Sample — configuration
#
# Copy this file to `.env.local` and fill it in. Every value is read on the
# SERVER (in the /api/chat route) — none of these secrets are ever sent to the
# browser. Restart `npm run dev` after changing anything here.
#
# ─────────────────────────────────────────────────────────────────────────────
# Khwan · the memory layer
# ─────────────────────────────────────────────────────────────────────────────

# Your Khwan API key (starts with kwk_). Get one from the Khwan dashboard. Required.
KHWAN_API_KEY=kwk_...

# Khwan API base URL. Optional — defaults to https://api.khwan.ai
# Point at http://127.0.0.1:8010 to run against a local engine.
KHWAN_BASE_URL=https://api.khwan.ai

# Optional end-user id → an ISOLATED sub-brain per user (paid feature).
# Leave blank for one shared brain per account/core.
KHWAN_USER=

# Optional isolated core slug. Leave blank for the account's default core.
KHWAN_CORE=

# ─────────────────────────────────────────────────────────────────────────────
# Your model · the generation step (bring your own model)
# ─────────────────────────────────────────────────────────────────────────────
# Khwan never runs a model. It prepares the context; the provider below
# generates the reply. Pick ONE provider and fill in its three values.

# Which provider family to use. One of: openai | anthropic | google
MODEL_PROVIDER=openai

# The provider API key.
MODEL_API_KEY=sk-...

# The model name (see the per-provider examples below).
MODEL_NAME=gpt-4o-mini

# Optional base-URL override. Leave blank to use the provider's default.
# Set it to reach any OpenAI-COMPATIBLE endpoint (see below).
MODEL_BASE_URL=

# Optional cap on generated tokens. Defaults to 1024.
MODEL_MAX_TOKENS=1024

# ─────────────────────────────────────────────────────────────────────────────
# Provider cheat-sheet — copy the values for the one you use
# ─────────────────────────────────────────────────────────────────────────────
#
# OpenAI
#   MODEL_PROVIDER=openai
#   MODEL_API_KEY=sk-...
#   MODEL_NAME=gpt-4o-mini
#   MODEL_BASE_URL=                       # default https://api.openai.com/v1
#
# Anthropic (Claude)
#   MODEL_PROVIDER=anthropic
#   MODEL_API_KEY=sk-ant-...
#   MODEL_NAME=claude-3-5-haiku-latest
#   MODEL_BASE_URL=                       # default https://api.anthropic.com
#
# Google (Gemini)
#   MODEL_PROVIDER=google
#   MODEL_API_KEY=AIza...
#   MODEL_NAME=gemini-1.5-flash
#   MODEL_BASE_URL=                       # default https://generativelanguage.googleapis.com
#
# ── Any OpenAI-compatible endpoint (MODEL_PROVIDER=openai + a base URL) ──
#
# Groq        MODEL_BASE_URL=https://api.groq.com/openai/v1   MODEL_NAME=llama-3.3-70b-versatile
# OpenRouter  MODEL_BASE_URL=https://openrouter.ai/api/v1     MODEL_NAME=openai/gpt-4o-mini
# DeepSeek    MODEL_BASE_URL=https://api.deepseek.com/v1      MODEL_NAME=deepseek-chat
# Together    MODEL_BASE_URL=https://api.together.xyz/v1      MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Mistral     MODEL_BASE_URL=https://api.mistral.ai/v1        MODEL_NAME=mistral-small-latest
# xAI (Grok)  MODEL_BASE_URL=https://api.x.ai/v1              MODEL_NAME=grok-2-latest
# Ollama      MODEL_BASE_URL=http://localhost:11434/v1        MODEL_NAME=llama3.2   MODEL_API_KEY=ollama
# LM Studio   MODEL_BASE_URL=http://localhost:1234/v1         MODEL_NAME=<loaded-model>
