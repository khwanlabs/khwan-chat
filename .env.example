# FieldCore API credentials (server-side only — never exposed to the browser).

# API key sent as the X-API-Key header.
FIELDCORE_API_KEY=your-fieldcore-api-key

# Base URL of the FieldCore API. The route handler appends /chat.
FIELDCORE_API_URL=https://api.fieldcore.example

# The signed-in end-user id sent as X-FieldCore-User.
# Fallback identity used ONLY when nobody is signed in via Google (the demo
# account). Once a user signs in, their Google id_token is forwarded instead.
FIELDCORE_USER=demo-user

# --- NextAuth (Google login) ------------------------------------------------
# Server-side only — never exposed to the browser. Use the same Google OAuth
# 2.0 Client ID as the dashboard. Register this redirect URI in Google Cloud
# Console → Credentials:  http://localhost:3003/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must match where the app runs.
NEXTAUTH_URL=http://localhost:3003
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-generated-secret
